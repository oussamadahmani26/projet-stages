t REST, HTTP Basic, trois tentatives si la connexion échoue.&#10;def AUTH = 'Basic ' + 'soa_client:soa_dev_password'.bytes.encodeBase64().toString()&#10;def client = java.net.http.HttpClient.newBuilder().connectTimeout(java.time.Duration.ofSeconds(3)).build()&#10;def envoyer = { String methode, String url, String type, String corps -&gt;&#10;    def contenu = corps == null ? java.net.http.HttpRequest.BodyPublishers.noBody() : java.net.http.HttpRequest.BodyPublishers.ofString(corps)&#10;    def requete = java.net.http.HttpRequest.newBuilder(new URI(url)).timeout(java.time.Duration.ofSeconds(15))&#10;            .header('Authorization', AUTH).header('Content-Type', type).method(methode, contenu).build()&#10;    for (int essai = 1; ; essai++) {&#10;        try {&#10;            return client.send(requete, java.net.http.HttpResponse.BodyHandlers.ofString())&#10;        } catch (java.net.ConnectException e) {&#10;            if (essai == 3) throw new RuntimeException('Service indisponible : ' + url)&#10;            Thread.sleep(300)&#10;        }&#10;    }&#10;}&#10;def soap = { int port, String chemin, String ns, String op, Map p -&gt;&#10;    def champs = p.collect { k, v -&gt; v == null ? '' : '&lt;' + k + '&gt;' + groovy.xml.XmlUtil.escapeXml(v.toString()) + '&lt;/' + k + '&gt;' }.join()&#10;    def env = '&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:n=&quot;' + ns + '&quot;&gt;&lt;soapenv:Body&gt;&lt;n:' + op + '&gt;' + champs + '&lt;/n:' + op + '&gt;&lt;/soapenv:Body&gt;&lt;/soapenv:Envelope&gt;'&#10;    def url = 'http://localhost:' + port + chemin&#10;    def r = envoyer('POST', url, 'text/xml; charset=utf-8', env)&#10;    if (r.statusCode() != 200 &amp;&amp; r.statusCode() != 500) throw new RuntimeException('Service indisponible : ' + url)&#10;    def doc = new groovy.xml.XmlSlurper().parseText(r.body())&#10;    def faute = doc.'**'.find { it.name() == 'Fault' }&#10;    if (faute) throw new RuntimeException(faute.faultstring.text())&#10;    return doc.Body.'*'[0].'*'[0]&#10;}&#10;def etudiants = { String op, Map p -&gt; soap(8081, '/ws/etudiants', 'http://soa.inpt.ma/etudiants', op, p) }&#10;def entreprises = { String op, Map p -&gt; soap(8082, '/ws/entreprises', 'http://soa.inpt.ma/entreprises', op, p) }&#10;def offres = { String op, Map p -&gt; soap(8083, '/ws/offres', 'http://soa.inpt.ma/offres', op, p) }&#10;def rest = { String methode, String url, Object corps -&gt;&#10;    def r = envoyer(methode, url, 'application/json', corps == null ? null : groovy.json.JsonOutput.toJson(corps))&#10;    def lu = r.body() ? new groovy.json.JsonSlurper().parseText(r.body()) : null&#10;    if (r.statusCode() &gt;= 200 &amp;&amp; r.statusCode() &lt; 300) return lu&#10;    throw new RuntimeException(lu?.message ?: 'Erreur HTTP ' + r.statusCode() + ' : ' + url)&#10;}&#10;def CANDIDATURES = 'http://localhost:8084/api/candidatures'&#10;def NOTIFICATIONS = 'http://localhost:8085/api/notifications'&#10;def STAGES = 'http://localhost:8086/api/stages'&#10;def notifier = { String type, String dest, Integer idDest, String email, String sujet, String message, Integer idCand, Integer idOffre -&gt;&#10;    rest('POST', NOTIFICATIONS, [type: type, destinataireType: dest, destinataireId: idDest, destinataireEmail: email, sujet: sujet, message: message, idCandidature: idCand, idOffre: idOffre])&#10;}&#10;def ajouterMotif = { String m -&gt; ctx.motifs = ctx.motifs ? ctx.motifs + ' ' + m : m }&#10;&#10;// Traitement de cette tâche&#10;try {&#10;    notifier('DEMANDE_COMPLEMENT', 'ETUDIANT', ctx.idEtudiant, ctx.emailEtudiant, &quot;Complément d'information demandé&quot;,&#10;            ctx.nomEntreprise + &quot; demande un complément pour l'offre « &quot; + ctx.titreOffre + &quot; »&quot; + (ctx.motifDecision ? ' : ' + ctx.motifDecision : '.'), ctx.candidatureId, ctx.idOffre)&#10;} catch (Exception e) {&#10;    ctx.avertissement = e.message ?: e.class.simpleName&#10;}&#10;return ctx&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_x1VQo4QrRUQyc51jzH8f4g" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></rightOperand><operator xmi:type="expression:Operator" xmi:id="_AjAOk9FDz4RfWtgUxeNstw" type="ASSIGNMENT"/></operations></elements>
<elements xmi:type="process:ServiceTask" xmi:id="_FqkN1WTQo9XoR6rrOWhOMQ" name="Confirmer, réserver la place (SOAP)" outgoing="_v_eKUfvxaMDltHgygmPkyw" incoming="_0ah4ay638gFq1T5GzrHROw _1iFacVQVo0Uu90P6ukI7fQ"><dynamicLabel xmi:type="expression:Expression" xmi:id="_X4CQt3sGN0X0ObG_HCELUA" name="" content="" returnTypeFixed="true"/><dynamicDescription xmi:type="expression:Expression" xmi:id="_lCfVZOJapuhUnmPWTalBNw" name="" content="" returnTypeFixed="true"/><stepSummary xmi:type="expression:Expression" xmi:id="_9yElNLbgNY6ppTZ1rzmYeQ" name="" content="" returnTypeFixed="true"/><loopCondition xmi:type="expression:Expression" xmi:id="_PRPqzAW0bLQ5RFhNKkVyBw" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><loopMaximum xmi:type="expression:Expression" xmi:id="_TQvphdt0WZBU6lw_xEgoCQ" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><cardinalityExpression xmi:type="expression:Expression" xmi:id="_YLRPvguk8AFfZnXYR0S6mg" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><iteratorExpression xmi:type="expression:Expression" xmi:id="_Sgdvot76vK1AXUNh_nytxg" name="multiInstanceIterator" content="multiInstanceIterator" type="MULTIINSTANCE_ITERATOR_TYPE" returnType="java.lang.Object" returnTypeFixed="true"/><completionCondition xmi:type="expression:Expression" xmi:id="_fQswD14qfY2aePWL2dM5Xw" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><operations xmi:type="expression:Operation" xmi:id="_InxkKUuiKnjRDpKAK4aI4A"><leftOperand xmi:type="expression:Expression" xmi:id="_6yHnmt1e91oPmQw2C0sqaQ" name="ctx" content="ctx" type="TYPE_VARIABLE" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_Wr6cnMPULcmUuyqqP6rG0Q" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></leftOperand><rightOperand xmi:type="expression:Expression" xmi:id="_XqtAH4OhU45piD0g5jP8Qw" name="confirmerDecision" content="// Appels aux services : SOAP et REST, HTTP Basic, trois tentatives si la connexion échoue.&#10;def AUTH = 'Basic ' + 'soa_client:soa_dev_password'.bytes.encodeBase64().toString()&#10;def client = java.net.http.HttpClient.newBuilder().connectTimeout(java.time.Duration.ofSeconds(3)).build()&#10;def envoyer = { String methode, String url, String type, String corps -&gt;&#10;    def contenu = corps == null ? java.net.http.HttpRequest.BodyPublishers.noBody() : java.net.http.HttpRequest.BodyPublishers.ofString(corps)&#10;    def requete = java.net.http.HttpRequest.newBuilder(new URI(url)).timeout(java.time.Duration.ofSeconds(15))&#10;            .header('Authorization', AUTH).header('Content-Type', type).method(methode, contenu).build()&#10;    for (int essai = 1; ; essai++) {&#10;        try {&#10;            return client.send(requete, java.net.http.HttpResponse.BodyHandlers.ofString())&#10;        } catch (java.net.ConnectException e) {&#10;            if (essai == 3) throw new RuntimeException('Service indisponible : ' + url)&#10;            Thread.sleep(300)&#10;        }&#10;    }&#10;}&#10;def soap = { int port, String chemin, String ns, String op, Map p -&gt;&#10;    def champs = p.collect { k, v -&gt; v == null ? '' : '&lt;' + k + '&gt;' + groovy.xml.XmlUtil.escapeXml(v.toString()) + '&lt;/' + k + '&gt;' }.join()&#10;    def env = '&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:n=&quot;' + ns + '&quot;&gt;&lt;soapenv:Body&gt;&lt;n:' + op + '&gt;' + champs + '&lt;/n:' + op + '&gt;&lt;/soapenv:Body&gt;&lt;/soapenv:Envelope&gt;'&#10;    def url = 'http://localhost:' + port + chemin&#10;    def r = envoyer('POST', url, 'text/xml; charset=utf-8', env)&#10;    if (r.statusCode() != 200 &amp;&amp; r.statusCode() != 500) throw new RuntimeException('Service indisponible : ' + url)&#10;    def doc = new groovy.xml.XmlSlurper().parseText(r.body())&#10;    def faute = doc.'**'.find { it.name() == 'Fault' }&#10;    if (faute) throw new RuntimeException(faute.faultstring.text())&#10;    return doc.Body.'*'[0].'*'[0]&#10;}&#10;def etudiants = { String op, Map p -&gt; soap(8081, '/ws/etudiants', 'http://soa.inpt.ma/etudiants', op, p) }&#10;def entreprises = { String op, Map p -&gt; soap(8082, '/ws/entreprises', 'http://soa.inpt.ma/entreprises', op, p) }&#10;def offres = { String op, Map p -&gt; soap(8083, '/ws/offres', 'http://soa.inpt.ma/offres', op, p) }&#10;def rest = { String methode, String url, Object corps -&gt;&#10;    def r = envoyer(methode, url, 'application/json', corps == null ? null : groovy.json.JsonOutput.toJson(corps))&#10;    def lu = r.body() ? new groovy.json.JsonSlurper().parseText(r.body()) : null&#10;    if (r.statusCode() &gt;= 200 &amp;&amp; r.statusCode() &lt; 300) return lu&#10;    throw new RuntimeException(lu?.message ?: 'Erreur HTTP ' + r.statusCode() + ' : ' + url)&#10;}&#10;def CANDIDATURES = 'http://localhost:8084/api/candidatures'&#10;def NOTIFICATIONS = 'http://localhost:8085/api/notifications'&#10;def STAGES = 'http://localhost:8086/api/stages'&#10;def notifier = { String type, String dest, Integer idDest, String email, String sujet, String message, Integer idCand, Integer idOffre -&gt;&#10;    rest('POST', NOTIFICATIONS, [type: type, destinataireType: dest, destinataireId: idDest, destinataireEmail: email, sujet: sujet, message: message, idCandidature: idCand, idOffre: idOffre])&#10;}&#10;def ajouterMotif = { String m -&gt; ctx.motifs = ctx.motifs ? ctx.motifs + ' ' + m : m }&#10;&#10;// Traitement de cette tâche&#10;if (ctx.erreur) return ctx&#10;try {&#10;    ctx.etape = 'CLOTURE'&#10;    if (ctx.decision == 'ACCEPTEE' &amp;&amp; !ctx.placeReservee) {&#10;        if (etudiants('verifierEtudiant', [matricule: ctx.matricule]).eligible.text() != 'true') {&#10;            ctx.decision = 'REFUSEE'&#10;            ctx.motifDecision = &quot;L'étudiant n'est plus disponible pour ce stage.&quot;&#10;        } else if (offres('reserverPlace', [idOffre: ctx.idOffre]).text() == 'true') {&#10;            ctx.placeReservee = true&#10;        } else {&#10;            ctx.decision = 'REFUSEE'&#10;            ctx.motifDecision = 'Toutes les places de cette offre ont été attribuées.'&#10;        }&#10;    }&#10;} catch (Exception e) {&#10;    ctx.erreur = e.message ?: e.class.simpleName&#10;}&#10;return ctx&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_aVR3ZARNG2xzroA_NVFO3A" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></rightOperand><operator xmi:type="expression:Operator" xmi:id="_bGhp_e1M0Go_L_KqQzbwhQ" type="ASSIGNMENT"/></operations></elements>
