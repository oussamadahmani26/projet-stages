<elements xmi:type="process:ServiceTask" xmi:id="_yy5AgD_aMNCUsxd8cAbVOw" name="Vérifier l'étudiant (SOAP)" outgoing="_FcCMYHg9X0dt8uhVdJwegw" incoming="_CQjGzpZctxbBoKwqE3nFhg _75wt4QkPs5QLmzhfDEmppw"><dynamicLabel xmi:type="expression:Expression" xmi:id="_tSaTehhLViMaR6YbRu02sg" name="" content="" returnTypeFixed="true"/><dynamicDescription xmi:type="expression:Expression" xmi:id="_QoZ9K2IFhar47HftNmcuuQ" name="" content="" returnTypeFixed="true"/><stepSummary xmi:type="expression:Expression" xmi:id="_eZTAuKa7X500CG0oR4es3g" name="" content="" returnTypeFixed="true"/><loopCondition xmi:type="expression:Expression" xmi:id="_IwJgf2R6sQjJWYjK5_JQfw" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><loopMaximum xmi:type="expression:Expression" xmi:id="_JisYlJmzwDHKAtDJkC_orA" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><cardinalityExpression xmi:type="expression:Expression" xmi:id="_d2Ujm23i32dhf_f1H_yu7Q" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><iteratorExpression xmi:type="expression:Expression" xmi:id="_iNAGol4fgO1zSxvK9IdsSg" name="multiInstanceIterator" content="multiInstanceIterator" type="MULTIINSTANCE_ITERATOR_TYPE" returnType="java.lang.Object" returnTypeFixed="true"/><completionCondition xmi:type="expression:Expression" xmi:id="_cHGqNB2Oi02uPB90YeDwxg" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><operations xmi:type="expression:Operation" xmi:id="_VI81yR4JUt0bfleZ8sfxiQ"><leftOperand xmi:type="expression:Expression" xmi:id="_3sFpn7v4tdpHlpoDP0O1Gg" name="ctx" content="ctx" type="TYPE_VARIABLE" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_MwvYPHS2WSp2ua7t9hi0iQ" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></leftOperand><rightOperand xmi:type="expression:Expression" xmi:id="_uC6IxuyqPVMyCniiOrJ_Gg" name="verifierEtudiant" content="// Appels aux services : SOAP et REST, HTTP Basic, trois tentatives si la connexion échoue.&#10;def AUTH = 'Basic ' + 'soa_client:soa_dev_password'.bytes.encodeBase64().toString()&#10;def client = java.net.http.HttpClient.newBuilder().connectTimeout(java.time.Duration.ofSeconds(3)).build()&#10;def envoyer = { String methode, String url, String type, String corps -&gt;&#10;    def contenu = corps == null ? java.net.http.HttpRequest.BodyPublishers.noBody() : java.net.http.HttpRequest.BodyPublishers.ofString(corps)&#10;    def requete = java.net.http.HttpRequest.newBuilder(new URI(url)).timeout(java.time.Duration.ofSeconds(15))&#10;            .header('Authorization', AUTH).header('Content-Type', type).method(methode, contenu).build()&#10;    for (int essai = 1; ; essai++) {&#10;        try {&#10;            return client.send(requete, java.net.http.HttpResponse.BodyHandlers.ofString())&#10;        } catch (java.net.ConnectException e) {&#10;            if (essai == 3) throw new RuntimeException('Service indisponible : ' + url)&#10;            Thread.sleep(300)&#10;        }&#10;    }&#10;}&#10;def soap = { int port, String chemin, String ns, String op, Map p -&gt;&#10;    def champs = p.collect { k, v -&gt; v == null ? '' : '&lt;' + k + '&gt;' + groovy.xml.XmlUtil.escapeXml(v.toString()) + '&lt;/' + k + '&gt;' }.join()&#10;    def env = '&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:n=&quot;' + ns + '&quot;&gt;&lt;soapenv:Body&gt;&lt;n:' + op + '&gt;' + champs + '&lt;/n:' + op + '&gt;&lt;/soapenv:Body&gt;&lt;/soapenv:Envelope&gt;'&#10;    def url = 'http://localhost:' + port + chemin&#10;    def r = envoyer('POST', url, 'text/xml; charset=utf-8', env)&#10;    if (r.statusCode() != 200 &amp;&amp; r.statusCode() != 500) throw new RuntimeException('Service indisponible : ' + url)&#10;    def doc = new groovy.xml.XmlSlurper().parseText(r.body())&#10;    def faute = doc.'**'.find { it.name() == 'Fault' }&#10;    if (faute) throw new RuntimeException(faute.faultstring.text())&#10;    return doc.Body.'*'[0].'*'[0]&#10;}&#10;def etudiants = { String op, Map p -&gt; soap(8081, '/ws/etudiants', 'http://soa.inpt.ma/etudiants', op, p) }&#10;def entreprises = { String op, Map p -&gt; soap(8082, '/ws/entreprises', 'http://soa.inpt.ma/entreprises', op, p) }&#10;def offres = { String op, Map p -&gt; soap(8083, '/ws/offres', 'http://soa.inpt.ma/offres', op, p) }&#10;def rest = { String methode, String url, Object corps -&gt;&#10;    def r = envoyer(methode, url, 'application/json', corps == null ? null : groovy.json.JsonOutput.toJson(corps))&#10;    def lu = r.body() ? new groovy.json.JsonSlurper().parseText(r.body()) : null&#10;    if (r.statusCode() &gt;= 200 &amp;&amp; r.statusCode() &lt; 300) return lu&#10;    throw new RuntimeException(lu?.message ?: 'Erreur HTTP ' + r.statusCode() + ' : ' + url)&#10;}&#10;def CANDIDATURES = 'http://localhost:8084/api/candidatures'&#10;def NOTIFICATIONS = 'http://localhost:8085/api/notifications'&#10;def STAGES = 'http://localhost:8086/api/stages'&#10;def notifier = { String type, String dest, Integer idDest, String email, String sujet, String message, Integer idCand, Integer idOffre -&gt;&#10;    rest('POST', NOTIFICATIONS, [type: type, destinataireType: dest, destinataireId: idDest, destinataireEmail: email, sujet: sujet, message: message, idCandidature: idCand, idOffre: idOffre])&#10;}&#10;def ajouterMotif = { String m -&gt; ctx.motifs = ctx.motifs ? ctx.motifs + ' ' + m : m }&#10;&#10;// Traitement de cette tâche&#10;if (ctx.erreur) return ctx&#10;try {&#10;    ctx.etape = 'CONTROLES'&#10;    ctx.motifs = ''&#10;    def v = etudiants('verifierEtudiant', [matricule: ctx.matricule])&#10;    if (v.eligible.text() != 'true') ajouterMotif(v.motif.text())&#10;    if (v.existe.text() == 'true') {&#10;        def e = etudiants('consulterEtudiant', [matricule: ctx.matricule])&#10;        ctx.idEtudiant = e.idEtudiant.text() as Integer&#10;        ctx.nomEtudiant = e.nom.text()&#10;        ctx.emailEtudiant = e.email.text()&#10;        ctx.filiere = e.filiere.text()&#10;        ctx.niveauEtudes = e.niveauEtudes.text()&#10;    }&#10;} catch (Exception e) {&#10;    ctx.erreur = e.message ?: e.class.simpleName&#10;}&#10;return ctx&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_7pQNUVBYvxjiAr1XxoleCQ" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></rightOperand><operator xmi:type="expression:Operator" xmi:id="_Een3eGO7nRhu54AumalinA" type="ASSIGNMENT"/></operations></elements>
<elements xmi:type="process:ServiceTask" xmi:id="_37Z1hkR9hn6wOnxBaYx0aA" name="Vérifier offre et entreprise (SOAP)" outgoing="_xIHkHpd17B_hN7drhIC5kw" incoming="_FcCMYHg9X0dt8uhVdJwegw"><dynamicLabel xmi:type="expression:Expression" xmi:id="_TBC1kG0GJUYJRSavvYH4wg" name="" content="" returnTypeFixed="true"/><dynamicDescription xmi:type="expression:Expression" xmi:id="_xiaFQ28Fp6knn4pBkqwHCw" name="" content="" returnTypeFixed="true"/><stepSummary xmi:type="expression:Expression" xmi:id="_sGHxJ1NK5v9_3svOAspx_g" name="" content="" returnTypeFixed="true"/><loopCondition xmi:type="expression:Expression" xmi:id="_JCaR_U7vUXtUrH6OGyc9zg" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><loopMaximum xmi:type="expression:Expression" xmi:id="_aBzxuQ5HL5p4YUE4v3f_OA" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><cardinalityExpression xmi:type="expression:Expression" xmi:id="_zjeZXgIxwawSz9J1F3BEcQ" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><iteratorExpression xmi:type="expression:Expression" xmi:id="_pCfwUPNYelwfxpEAAOwOFw" name="multiInstanceIterator" content="multiInstanceIterator" type="MULTIINSTANCE_ITERATOR_TYPE" returnType="java.lang.Object" returnTypeFixed="true"/><completionCondition xmi:type="expression:Expression" xmi:id="_gmLPfWZfIFn3Bctf_NJGZw" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><operations xmi:type="expression:Operation" xmi:id="_9Obx_vF0e8s1ACiQnryDZQ"><leftOperand xmi:type="expression:Expression" xmi:id="_6ENMEQxzhofQO_nUvyWIdA" name="ctx" content="ctx" type="TYPE_VARIABLE" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_AS0xxkzCuxUxNNqvWm76fA" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></leftOperand><rightOperand xmi:type="expression:Expression" xmi:id="_lADo18gH6Y1VdjDYoLjJJw" name="verifierOffre" content="// Appels aux services : SOAP et REST, HTTP Basic, trois tentatives si la connexion échoue.&#10;def AUTH = 'Basic ' + 'soa_client:soa_dev_password'.bytes.encodeBase64().toString()&#10;def client = java.net.http.HttpClient.newBuilder().connectTimeout(java.time.Duration.ofSeconds(3)).build()&#10;def envoyer = { String methode, String url, String type, String corps -&gt;&#10;    def contenu = corps == null ? java.net.http.HttpRequest.BodyPublishers.noBody() : java.net.http.HttpRequest.BodyPublishers.ofString(corps)&#10;    def requete = java.net.http.HttpRequest.newBuilder(new URI(url)).timeout(java.time.Duration.ofSeconds(15))&#10;            .header('Authorization', AUTH).header('Content-Type', type).method(methode, contenu).build()&#10;    for (int essai = 1; ; essai++) {&#10;        try {&#10;            return client.send(requete, java.net.http.HttpResponse.BodyHandlers.ofString())&#10;        } catch (java.net.ConnectException e) {&#10;            if (essai == 3) throw new RuntimeException('Service indisponible : ' + url)&#10;            Thread.sleep(300)&#10;        }&#10;    }&#10;}&#10;def soap = { int port, String chemin, String ns, String op, Map p -&gt;&#10;    def champs = p.collect { k, v -&gt; v == null ? '' : '&lt;' + k + '&gt;' + groovy.xml.XmlUtil.escapeXml(v.toString()) + '&lt;/' + k + '&gt;' }.join()&#10;    def env = '&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:n=&quot;' + ns + '&quot;&gt;&lt;soapenv:Body&gt;&lt;n:' + op + '&gt;' + champs + '&lt;/n:' + op + '&gt;&lt;/soapenv:Body&gt;&lt;/soapenv:Envelope&gt;'&#10;    def url = 'http://localhost:' + port + chemin&#10;    def r = envoyer('POST', url, 'text/xml; charset=utf-8', env)&#10;    if (r.statusCode() != 200 &amp;&amp; r.statusCode() != 500) throw new RuntimeException('Service indisponible : ' + url)&#10;    def doc = new groovy.xml.XmlSlurper().parseText(r.body())&#10;    def faute = doc.'**'.find { it.name() == 'Fault' }&#10;    if (faute) throw new RuntimeException(faute.faultstring.text())&#10;    return doc.Body.'*'[0].'*'[0]&#10;}&#10;def etudiants = { String op, Map p -&gt; soap(8081, '/ws/etudiants', 'http://soa.inpt.ma/etudiants', op, p) }&#10;def entreprises = { String op, Map p -&gt; soap(8082, '/ws/entreprises', 'http://soa.inpt.ma/entreprises', op, p) }&#10;def offres = { String op, Map p -&gt; soap(8083, '/ws/offres', 'http://soa.inpt.ma/offres', op, p) }&#10;def rest = { String methode, String url, Object corps -&gt;&#10;    def r = envoyer(methode, url, 'application/json', corps == null ? null : groovy.json.JsonOutput.toJson(corps))&#10;    def lu = r.body() ? new groovy.json.JsonSlurper().parseText(r.body()) : null&#10;    if (r.statusCode() &gt;= 200 &amp;&amp; r.statusCode() &lt; 300) return lu&#10;    throw new RuntimeException(lu?.message ?: 'Erreur HTTP ' + r.statusCode() + ' : ' + url)&#10;}&#10;def CANDIDATURES = 'http://localhost:8084/api/candidatures'&#10;def NOTIFICATIONS = 'http://localhost:8085/api/notifications'&#10;def STAGES = 'http://localhost:8086/api/stages'&#10;def notifier = { String type, String dest, Integer idDest, String email, String sujet, String message, Integer idCand, Integer idOffre -&gt;&#10;    rest('POST', NOTIFICATIONS, [type: type, destinataireType: dest, destinataireId: idDest, destinataireEmail: email, sujet: sujet, message: message, idCandidature: idCand, idOffre: idOffre])&#10;}&#10;def ajouterMotif = { String m -&gt; ctx.motifs = ctx.motifs ? ctx.motifs + ' ' + m : m }&#10;&#10;// Traitement de cette tâche&#10;if (ctx.erreur) return ctx&#10;try {&#10;    def o = offres('verifierDisponibilite', [idOffre: ctx.idOffre])&#10;    ctx.offreConnue = o.existe.text() == 'true'&#10;    if (!ctx.offreConnue) {&#10;        ajouterMotif(o.motif.text())&#10;        return ctx&#10;    }&#10;    ctx.titreOffre = o.titre.text()&#10;    ctx.dureeMois = o.dureeMois.text() as Integer&#10;    ctx.dateLimite = o.dateLimite.text()&#10;    ctx.places = o.placesDisponibles.text() as Integer&#10;    if (o.statut.text() != 'ACTIVE') ajouterMotif(&quot;L'offre n'est plus active.&quot;)&#10;    ctx.idEntreprise = o.idEntreprise.text() as Integer&#10;    if (entreprises('verifierEntreprise', [idEntreprise: ctx.idEntreprise]).text() == 'true') {&#10;        def e = entreprises('consulterEntreprise', [idEntreprise: ctx.idEntreprise])&#10;        ctx.nomEntreprise = e.nom.text()&#10;        ctx.emailEntreprise = e.email.text()&#10;    } else {&#10;        ajouterMotif(&quot;L'entreprise n'est pas référencée.&quot;)&#10;    }&#10;    if (ctx.idEtudiant != null) {&#10;        def c = offres('verifierCompatibilite', [idOffre: ctx.idOffre, filiere: ctx.filiere, niveauEtudes: ctx.niveauEtudes])&#10;        if (c.compatible.text() != 'true') ajouterMotif(c.motif.text())&#10;    }&#10;} catch (Exception e) {&#10;    ctx.erreur = e.message ?: e.class.simpleName&#10;}&#10;return ctx&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_H56eRBHY5p0iCuEgIKi2hQ" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></rightOperand><operator xmi:type="expression:Operator" xmi:id="_Dupw4OXVJQFqufr1OJftxQ" type="ASSIGNMENT"/></operations></elements>
<elements xmi:type="process:ServiceTask" xmi:id="_yhh8LLcvNG9NU3AexZ2P6w" name="Contrôler la candidature (REST)" outgoing="_GoZ2xiVsJ7u39NYqOg3AmA" incoming="_xIHkHpd17B_hN7drhIC5kw"><dynamicLabel xmi:type="expression:Expression" xmi:id="_bnCJNQApnACfpjSCK0QCyQ" name="" content="" returnTypeFixed="true"/><dynamicDescription xmi:type="expression:Expression" xmi:id="_rCSy9ndhiRqxCih8Ym6U8w" name="" content="" returnTypeFixed="true"/><stepSummary xmi:type="expression:Expression" xmi:id="_QFsy7itouIQ7R7kHdv4SGA" name="" content="" returnTypeFixed="true"/><loopCondition xmi:type="expression:Expression" xmi:id="_kV9GGY3owd90VMlMIx7NYg" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><loopMaximum xmi:type="expression:Expression" xmi:id="__pYxNkK3ZlxkaTg0wKDXag" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><cardinalityExpression xmi:type="expression:Expression" xmi:id="_vrWLCzgFaEsQ_0HlhZcq7A" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><iteratorExpression xmi:type="expression:Expression" xmi:id="_7FbIPNfRDIVTeuwINx7ibA" name="multiInstanceIterator" content="multiInstanceIterator" type="MULTIINSTANCE_ITERATOR_TYPE" returnType="java.lang.Object" returnTypeFixed="true"/><completionCondition xmi:type="expression:Expression" xmi:id="_U2xPKtNh77VDecDPWoI_cQ" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><operations xmi:type="expression:Operation" xmi:id="_JTtv54jMNJmNHO_uu57ODQ"><leftOperand xmi:type="expression:Expression" xmi:id="_yaDnhDlXdyjODSnsPjfPdA" name="ctx" content="ctx" type="TYPE_VARIABLE" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_AACmrxSrYibbkauCOxBCNA" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></leftOperand><rightOperand xmi:type="expression:Expression" xmi:id="_jHZKmvnegOoE8rzjzLGsfA" name="controlerCandidature" content="// Appels aux services : SOAP et REST, HTTP Basic, trois tentatives si la connexion échoue.&#10;def AUTH = 'Basic ' + 'soa_client:soa_dev_password'.bytes.encodeBase64().toString()&#10;def client = java.net.http.HttpClient.newBuilder().connectTimeout(java.time.Duration.ofSeconds(3)).build()&#10;def envoyer = { String methode, String url, String type, String corps -&gt;&#10;    def contenu = corps == null ? java.net.http.HttpRequest.BodyPublishers.noBody() : java.net.http.HttpRequest.BodyPublishers.ofString(corps)&#10;    def requete = java.net.http.HttpRequest.newBuilder(new URI(url)).timeout(java.time.Duration.ofSeconds(15))&#10;            .header('Authorization', AUTH).header('Content-Type', type).method(methode, contenu).build()&#10;    for (int essai = 1; ; essai++) {&#10;        try {&#10;            return client.send(requete, java.net.http.HttpResponse.BodyHandlers.ofString())&#10;        } catch (java.net.ConnectException e) {&#10;            if (essai == 3) throw new RuntimeException('Service indisponible : ' + url)&#10;            Thread.sleep(300)&#10;        }&#10;    }&#10;}&#10;def soap = { int port, String chemin, String ns, String op, Map p -&gt;&#10;    def champs = p.collect { k, v -&gt; v == null ? '' : '&lt;' + k + '&gt;' + groovy.xml.XmlUtil.escapeXml(v.toString()) + '&lt;/' + k + '&gt;' }.join()&#10;    def env = '&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:n=&quot;' + ns + '&quot;&gt;&lt;soapenv:Body&gt;&lt;n:' + op + '&gt;' + champs + '&lt;/n:' + op + '&gt;&lt;/soapenv:Body&gt;&lt;/soapenv:Envelope&gt;'&#10;    def url = 'http://localhost:' + port + chemin&#10;    def r = envoyer('POST', url, 'text/xml; charset=utf-8', env)&#10;    if (r.statusCode() != 200 &amp;&amp; r.statusCode() != 500) throw new RuntimeException('Service indisponible : ' + url)&#10;    def doc = new groovy.xml.XmlSlurper().parseText(r.body())&#10;    def faute = doc.'**'.find { it.name() == 'Fault' }&#10;    if (faute) throw new RuntimeException(faute.faultstring.text())&#10;    return doc.Body.'*'[0].'*'[0]&#10;}&#10;def etudiants = { String op, Map p -&gt; soap(8081, '/ws/etudiants', 'http://soa.inpt.ma/etudiants', op, p) }&#10;def entreprises = { String op, Map p -&gt; soap(8082, '/ws/entreprises', 'http://soa.inpt.ma/entreprises', op, p) }&#10;def offres = { String op, Map p -&gt; soap(8083, '/ws/offres', 'http://soa.inpt.ma/offres', op, p) }&#10;def rest = { String methode, String url, Object corps -&gt;&#10;    def r = envoyer(methode, url, 'application/json', corps == null ? null : groovy.json.JsonOutput.toJson(corps))&#10;    def lu = r.body() ? new groovy.json.JsonSlurper().parseText(r.body()) : null&#10;    if (r.statusCode() &gt;= 200 &amp;&amp; r.statusCode() &lt; 300) return lu&#10;    throw new RuntimeException(lu?.message ?: 'Erreur HTTP ' + r.statusCode() + ' : ' + url)&#10;}&#10;def CANDIDATURES = 'http://localhost:8084/api/candidatures'&#10;def NOTIFICATIONS = 'http://localhost:8085/api/notifications'&#10;def STAGES = 'http://localhost:8086/api/stages'&#10;def notifier = { String type, String dest, Integer idDest, String email, String sujet, String message, Integer idCand, Integer idOffre -&gt;&#10;    rest('POST', NOTIFICATIONS, [type: type, destinataireType: dest, destinataireId: idDest, destinataireEmail: email, sujet: sujet, message: message, idCandidature: idCand, idOffre: idOffre])&#10;}&#10;def ajouterMotif = { String m -&gt; ctx.motifs = ctx.motifs ? ctx.motifs + ' ' + m : m }&#10;&#10;// Traitement de cette tâche&#10;if (ctx.erreur) return ctx&#10;try {&#10;    if (ctx.offreConnue) {&#10;        if (java.time.LocalDate.parse(ctx.dateLimite).isBefore(java.time.LocalDate.now())) ajouterMotif('La date limite de candidature est dépassée.')&#10;        if (ctx.places &lt;= 0) ajouterMotif('Plus aucune place disponible.')&#10;        if (ctx.idEtudiant != null) {&#10;            def liste = rest('GET', CANDIDATURES + '?idEtudiant=' + ctx.idEtudiant + '&amp;idOffre=' + ctx.idOffre, null)&#10;            if (liste.any { it.statut != 'ANNULEE' }) ajouterMotif('Une candidature existe déjà pour cette offre.')&#10;        }&#10;    }&#10;    ctx.valide = !ctx.motifs&#10;} catch (Exception e) {&#10;    ctx.erreur = e.message ?: e.class.simpleName&#10;}&#10;return ctx&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_40EZ9GeNwFJUmP7xRhfB4g" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></rightOperand><operator xmi:type="expression:Operator" xmi:id="_xyyc5hXapTQI27YoR9AO4w" type="ASSIGNMENT"/></operations></elements>
