<elements xmi:type="process:ServiceTask" xmi:id="_UlH3B7a2s3BZ63LuI_H35w" name="Compenser et prévenir l'étudiant" outgoing="_D18xLIrkci07OJM9lj1k1w" incoming="_Fr8QsCVbtgukXA7pa39WgQ"><dynamicLabel xmi:type="expression:Expression" xmi:id="_gObOg1PSrxn7KcoamJ_4hg" name="" content="" returnTypeFixed="true"/><dynamicDescription xmi:type="expression:Expression" xmi:id="_ruQkOpqipDIbCG4eWpsxCA" name="" content="" returnTypeFixed="true"/><stepSummary xmi:type="expression:Expression" xmi:id="_gdnjqQa6iGCIRsAGLMYuaw" name="" content="" returnTypeFixed="true"/><loopCondition xmi:type="expression:Expression" xmi:id="_nbEEfJOqWXmIzmqpSIzhSQ" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><loopMaximum xmi:type="expression:Expression" xmi:id="_6HgcquExm2h79FU5UCoA0Q" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><cardinalityExpression xmi:type="expression:Expression" xmi:id="_CZn2oKCVgx5oAe3hQocONw" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/><iteratorExpression xmi:type="expression:Expression" xmi:id="_MwJGEEZmHeNk76uYUnANIg" name="multiInstanceIterator" content="multiInstanceIterator" type="MULTIINSTANCE_ITERATOR_TYPE" returnType="java.lang.Object" returnTypeFixed="true"/><completionCondition xmi:type="expression:Expression" xmi:id="_N6qCJUnXIl6hFKytP_I_iA" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/><operations xmi:type="expression:Operation" xmi:id="_7mjxh9RouQyEg4nzyhZkqQ"><leftOperand xmi:type="expression:Expression" xmi:id="_CEcB8W1M98GFzVgaKi5IJQ" name="ctx" content="ctx" type="TYPE_VARIABLE" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_6jeDUM2WOD8ZQs65htflow" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></leftOperand><rightOperand xmi:type="expression:Expression" xmi:id="_CBK7NzSutI6rtdiHqe06rg" name="compenser" content="// Appels aux services : SOAP et REST, HTTP Basic, trois tentatives si la connexion échoue.&#10;def AUTH = 'Basic ' + 'soa_client:soa_dev_password'.bytes.encodeBase64().toString()&#10;def client = java.net.http.HttpClient.newBuilder().connectTimeout(java.time.Duration.ofSeconds(3)).build()&#10;def envoyer = { String methode, String url, String type, String corps -&gt;&#10;    def contenu = corps == null ? java.net.http.HttpRequest.BodyPublishers.noBody() : java.net.http.HttpRequest.BodyPublishers.ofString(corps)&#10;    def requete = java.net.http.HttpRequest.newBuilder(new URI(url)).timeout(java.time.Duration.ofSeconds(15))&#10;            .header('Authorization', AUTH).header('Content-Type', type).method(methode, contenu).build()&#10;    for (int essai = 1; ; essai++) {&#10;        try {&#10;            return client.send(requete, java.net.http.HttpResponse.BodyHandlers.ofString())&#10;        } catch (java.net.ConnectException e) {&#10;            if (essai == 3) throw new RuntimeException('Service indisponible : ' + url)&#10;            Thread.sleep(300)&#10;        }&#10;    }&#10;}&#10;def soap = { int port, String chemin, String ns, String op, Map p -&gt;&#10;    def champs = p.collect { k, v -&gt; v == null ? '' : '&lt;' + k + '&gt;' + groovy.xml.XmlUtil.escapeXml(v.toString()) + '&lt;/' + k + '&gt;' }.join()&#10;    def env = '&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:n=&quot;' + ns + '&quot;&gt;&lt;soapenv:Body&gt;&lt;n:' + op + '&gt;' + champs + '&lt;/n:' + op + '&gt;&lt;/soapenv:Body&gt;&lt;/soapenv:Envelope&gt;'&#10;    def url = 'http://localhost:' + port + chemin&#10;    def r = envoyer('POST', url, 'text/xml; charset=utf-8', env)&#10;    if (r.statusCode() != 200 &amp;&amp; r.statusCode() != 500) throw new RuntimeException('Service indisponible : ' + url)&#10;    def doc = new groovy.xml.XmlSlurper().parseText(r.body())&#10;    def faute = doc.'**'.find { it.name() == 'Fault' }&#10;    if (faute) throw new RuntimeException(faute.faultstring.text())&#10;    return doc.Body.'*'[0].'*'[0]&#10;}&#10;def etudiants = { String op, Map p -&gt; soap(8081, '/ws/etudiants', 'http://soa.inpt.ma/etudiants', op, p) }&#10;def entreprises = { String op, Map p -&gt; soap(8082, '/ws/entreprises', 'http://soa.inpt.ma/entreprises', op, p) }&#10;def offres = { String op, Map p -&gt; soap(8083, '/ws/offres', 'http://soa.inpt.ma/offres', op, p) }&#10;def rest = { String methode, String url, Object corps -&gt;&#10;    def r = envoyer(methode, url, 'application/json', corps == null ? null : groovy.json.JsonOutput.toJson(corps))&#10;    def lu = r.body() ? new groovy.json.JsonSlurper().parseText(r.body()) : null&#10;    if (r.statusCode() &gt;= 200 &amp;&amp; r.statusCode() &lt; 300) return lu&#10;    throw new RuntimeException(lu?.message ?: 'Erreur HTTP ' + r.statusCode() + ' : ' + url)&#10;}&#10;def CANDIDATURES = 'http://localhost:8084/api/candidatures'&#10;def NOTIFICATIONS = 'http://localhost:8085/api/notifications'&#10;def STAGES = 'http://localhost:8086/api/stages'&#10;def notifier = { String type, String dest, Integer idDest, String email, String sujet, String message, Integer idCand, Integer idOffre -&gt;&#10;    rest('POST', NOTIFICATIONS, [type: type, destinataireType: dest, destinataireId: idDest, destinataireEmail: email, sujet: sujet, message: message, idCandidature: idCand, idOffre: idOffre])&#10;}&#10;def ajouterMotif = { String m -&gt; ctx.motifs = ctx.motifs ? ctx.motifs + ' ' + m : m }&#10;&#10;// Abandon décidé par le responsable : chaque action est tentée, même si une autre échoue.&#10;def tenter = { Closure action -&gt;&#10;    try { action() } catch (Exception e) { ctx.avertissement = e.message }&#10;}&#10;if (ctx.placeReservee &amp;&amp; ctx.stageId == null) tenter { offres('libererPlace', [idOffre: ctx.idOffre]) }&#10;if (ctx.candidatureId != null) tenter { rest('DELETE', CANDIDATURES + '/' + ctx.candidatureId, null) }&#10;if (ctx.emailEtudiant) tenter {&#10;    notifier('CANDIDATURE_ANNULEE', 'ETUDIANT', ctx.idEtudiant, ctx.emailEtudiant, 'Traitement de candidature interrompu',&#10;            &quot;Suite à un incident technique, votre candidature n'a pas pu être traitée. Vous pouvez la déposer à nouveau.&quot;, ctx.candidatureId, ctx.idOffre)&#10;}&#10;return ctx&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="__SCtIPox29hoYGNO_6nGOw" name="ctx" dataType="_GO6Sjzx4ymmYoUPtJxuTbQ" className="java.util.HashMap"/></rightOperand><operator xmi:type="expression:Operator" xmi:id="_YStxx_Zl0mMin3AVke_J0w" type="ASSIGNMENT"/></operations></elements>
