.faultstring.text())&#10;    return doc.Body.'*'[0].'*'[0]&#10;}&#10;def etudiants = { String op, Map p -&gt; soap(8081, '/ws/etudiants', 'http://soa.inpt.ma/etudiants', op, p) }&#10;def entreprises = { String op, Map p -&gt; soap(8082, '/ws/entreprises', 'http://soa.inpt.ma/entreprises', op, p) }&#10;def offres = { String op, Map p -&gt; soap(8083, '/ws/offres', 'http://soa.inpt.ma/offres', op, p) }&#10;def rest = { String methode, String url, Object corps -&gt;&#10;    def r = envoyer(methode, url, 'application/json', corps == null ? null : groovy.json.JsonOutput.toJson(corps))&#10;    def lu = r.body() ? new groovy.json.JsonSlurper().parseText(r.body()) : null&#10;    if (r.statusCode() &gt;= 200 &amp;&amp; r.statusCode() &lt; 300) return lu&#10;    throw new RuntimeException(lu?.message ?: 'Erreur HTTP ' + r.statusCode() + ' : ' + url)&#10;}&#10;def CANDIDATURES = 'http://localhost:8084/api/candidatures'&#10;def NOTIFICATIONS = 'http://localhost:8085/api/notifications'&#10;def STAGES = 'http://localhost:8086/api/stages'&#10;def notifier = { String type, String dest, Integer idDest, String email, String sujet, String message, Integer idCand, Integer idOffre -&gt;&#10;    rest('POST', NOTIFICATIONS, [type: type, destinataireType: dest, destinataireId: idDest, destinataireEmail: email, sujet: sujet, message: message, idCandidature: idCand, idOffre: idOffre])&#10;}&#10;def ajouterMotif = { String m -&gt; ctx.motifs = ctx.motifs ? ctx.motifs + ' ' + m : m }&#10;&#10;// Traitement de cette tâche&#10;if (ctx.erreur) return ctx&#10;try {&#10;    rest('PATCH', CANDIDATURES + '/' + ctx.candidatureId + '/statut', [statut: ctx.decision, motif: ctx.motifDecision])&#10;} catch (Exception e) {&#10;    ctx.erreur = e.message ?: e.class.simpleName&#10;}&#10;return ctx&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.HashMap" returnTypeFixed="true"><referencedElements xmi:type="process:JavaObjectData" xmi:id="_6lVi2dy8xfYsP0xJ2jyBZA" name="ctx" dataTy