<?xml version="1.0" encoding="UTF-8"?>
<!-- Processus d'orchestration d'une candidature à une offre de stage (BPMN 2.0 standard).
     Les attributs flowable:* relient les tâches aux classes Java ; ils sont ignorés par les autres outils. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://soa.inpt.ma/processus">
  <error id="erreurService" name="Erreur ou indisponibilité d'un service" errorCode="ERREUR_SERVICE"/>
  <message id="msgAnnulation" name="annulationCandidature"/>
  <process id="candidature" name="Traitement d'une candidature de stage" isExecutable="true">
    <startEvent id="debut" name="Candidature soumise"/>
    <subProcess id="sp_controles" name="Contrôles préalables">
      <extensionElements><flowable:executionListener event="start" expression="${execution.setVariable('etapeEnErreur','CONTROLES')}"/></extensionElements>
      <startEvent id="c_debut"/>
      <serviceTask id="verifierEtudiant" name="Vérifier l'étudiant (SOAP)" flowable:class="ma.inpt.soa.processus.taches.VerifierEtudiant"></serviceTask>
      <serviceTask id="verifierOffre" name="Vérifier offre et entreprise (SOAP)" flowable:class="ma.inpt.soa.processus.taches.VerifierOffre"></serviceTask>
      <serviceTask id="controlerCandidature" name="Contrôler la candidature (REST)" flowable:class="ma.inpt.soa.processus.taches.ControlerCandidature"></serviceTask>
      <endEvent id="c_fin"/>
      <sequenceFlow id="f_c1" sourceRef="c_debut" targetRef="verifierEtudiant"/>
      <sequenceFlow id="f_c2" sourceRef="verifierEtudiant" targetRef="verifierOffre"/>
      <sequenceFlow id="f_c3" sourceRef="verifierOffre" targetRef="controlerCandidature"/>
      <sequenceFlow id="f_c4" sourceRef="controlerCandidature" targetRef="c_fin"/>
    </subProcess>
    <exclusiveGateway id="gw_valide" name="Conditions satisfaites ?" default="f_valide_oui"/>
    <serviceTask id="notifierRejet" name="Notifier le rejet (REST)" flowable:class="ma.inpt.soa.processus.taches.NotifierRejet"><extensionElements><flowable:executionListener event="start" expression="${execution.setVariable('etapeEnErreur','REJET')}"/></extensionElements></serviceTask>
    <endEvent id="fin_rejetee" name="Candidature rejetée"/>
    <subProcess id="sp_transmission" name="Enregistrement et transmission">
      <extensionElements><flowable:executionListener event="start" expression="${execution.setVariable('etapeEnErreur','TRANSMISSION')}"/></extensionElements>
      <startEvent id="t_debut"/>
      <serviceTask id="enregistrer" name="Enregistrer la candidature (REST)" flowable:class="ma.inpt.soa.processus.taches.EnregistrerCandidature"></serviceTask>
      <serviceTask id="confirmerDepot" name="Confirmer le dépôt (REST)" flowable:class="ma.inpt.soa.processus.taches.ConfirmerDepot"></serviceTask>
      <serviceTask id="notifierEntreprise" name="Notifier l'entreprise (REST)" flowable:class="ma.inpt.soa.processus.taches.NotifierEntreprise"></serviceTask>
      <serviceTask id="passerEvaluation" name="Passer en évaluation (REST)" flowable:class="ma.inpt.soa.processus.taches.PasserEnEvaluation"></serviceTask>
      <endEvent id="t_fin"/>
      <sequenceFlow id="f_t1" sourceRef="t_debut" targetRef="enregistrer"/>
      <sequenceFlow id="f_t2" sourceRef="enregistrer" targetRef="confirmerDepot"/>
      <sequenceFlow id="f_t3" sourceRef="confirmerDepot" targetRef="notifierEntreprise"/>
      <sequenceFlow id="f_t4" sourceRef="notifierEntreprise" targetRef="passerEvaluation"/>
      <sequenceFlow id="f_t5" sourceRef="passerEvaluation" targetRef="t_fin"/>
    </subProcess>
    <userTask id="decisionEntreprise" name="Décision de l'entreprise" flowable:candidateGroups="entreprise-${idEntreprise}"/>
    <boundaryEvent id="b_annulation" name="Annulation" attachedToRef="decisionEntreprise" cancelActivity="true"><messageEventDefinition messageRef="msgAnnulation"/></boundaryEvent>
    <serviceTask id="notifierAnnulation" name="Notifier l'annulation (REST)" flowable:class="ma.inpt.soa.processus.taches.NotifierAnnulation"></serviceTask>
    <endEvent id="fin_annulee" name="Candidature annulée"/>
    <exclusiveGateway id="gw_decision" name="Décision ?" default="f_dec_fin"/>
    <serviceTask id="notifierComplement" name="Demander complément (REST)" flowable:class="ma.inpt.soa.processus.taches.NotifierComplement"><extensionElements><flowable:executionListener event="start" expression="${execution.setVariable('etapeEnErreur','COMPLEMENT')}"/></extensionElements></serviceTask>
    <subProcess id="sp_cloture" name="Clôture de la candidature">
      <extensionElements><flowable:executionListener event="start" expression="${execution.setVariable('etapeEnErreur','CLOTURE')}"/></extensionElements>
      <startEvent id="k_debut"/>
      <serviceTask id="confirmerDecision" name="Confirmer, réserver la place (SOAP)" flowable:class="ma.inpt.soa.processus.taches.ConfirmerDecision"></serviceTask>
      <serviceTask id="majCandidature" name="Mettre à jour le statut (REST)" flowable:class="ma.inpt.soa.processus.taches.MettreAJourCandidature"></serviceTask>
      <serviceTask id="notifierResultat" name="Notifier le résultat (REST)" flowable:class="ma.inpt.soa.processus.taches.NotifierResultat"></serviceTask>
      <exclusiveGateway id="gw_acceptee" name="Acceptée ?" default="f_k_refus"/>
      <serviceTask id="creerStage" name="Créer le dossier de stage (REST)" flowable:class="ma.inpt.soa.processus.taches.CreerDossierStage"></serviceTask>
      <serviceTask id="majEtudiant" name="Statut étudiant : EN_STAGE (SOAP)" flowable:class="ma.inpt.soa.processus.taches.MettreAJourEtudiant"></serviceTask>
      <endEvent id="k_fin"/>
      <sequenceFlow id="f_k1" sourceRef="k_debut" targetRef="confirmerDecision"/>
      <sequenceFlow id="f_k2" sourceRef="confirmerDecision" targetRef="majCandidature"/>
      <sequenceFlow id="f_k3" sourceRef="majCandidature" targetRef="notifierResultat"/>
      <sequenceFlow id="f_k4" sourceRef="notifierResultat" targetRef="gw_acceptee"/>
      <sequenceFlow id="f_k_ok" sourceRef="gw_acceptee" targetRef="creerStage" name="Oui"><conditionExpression xsi:type="tFormalExpression">${decision == 'ACCEPTEE'}</conditionExpression></sequenceFlow>
      <sequenceFlow id="f_k_refus" sourceRef="gw_acceptee" targetRef="k_fin" name="Non"/>
      <sequenceFlow id="f_k5" sourceRef="creerStage" targetRef="majEtudiant"/>
      <sequenceFlow id="f_k6" sourceRef="majEtudiant" targetRef="k_fin"/>
    </subProcess>
    <exclusiveGateway id="gw_fin" name="Résultat ?" default="f_fin_refus"/>
    <endEvent id="fin_acceptee" name="Candidature acceptée"/>
    <endEvent id="fin_refusee" name="Candidature refusée"/>
    <boundaryEvent id="err_controles" name="Erreur service" attachedToRef="sp_controles" cancelActivity="true"><errorEventDefinition errorRef="erreurService"/></boundaryEvent>
    <boundaryEvent id="err_rejet" name="Erreur service" attachedToRef="notifierRejet" cancelActivity="true"><errorEventDefinition errorRef="erreurService"/></boundaryEvent>
    <boundaryEvent id="err_transmission" name="Erreur service" attachedToRef="sp_transmission" cancelActivity="true"><errorEventDefinition errorRef="erreurService"/></boundaryEvent>
    <boundaryEvent id="err_complement" name="Erreur service" attachedToRef="notifierComplement" cancelActivity="true"><errorEventDefinition errorRef="erreurService"/></boundaryEvent>
    <boundaryEvent id="err_cloture" name="Erreur service" attachedToRef="sp_cloture" cancelActivity="true"><errorEventDefinition errorRef="erreurService"/></boundaryEvent>
    <userTask id="traiterIncident" name="Traiter l'incident (responsable)" flowable:candidateGroups="responsables"/>
    <exclusiveGateway id="gw_action" name="Action ?" default="f_relancer"/>
    <serviceTask id="compenser" name="Compenser et prévenir l'étudiant" flowable:class="ma.inpt.soa.processus.taches.CompenserAbandon"></serviceTask>
    <endEvent id="fin_abandonnee" name="Traitement abandonné"/>
    <exclusiveGateway id="gw_route" name="Reprendre à quelle étape ?" default="f_r_controles"/>
    <sequenceFlow id="f_1" sourceRef="debut" targetRef="sp_controles" name="Dépôt"/>
    <sequenceFlow id="f_2" sourceRef="sp_controles" targetRef="gw_valide"/>
    <sequenceFlow id="f_valide_oui" sourceRef="gw_valide" targetRef="sp_transmission" name="Oui"/>
    <sequenceFlow id="f_valide_non" sourceRef="gw_valide" targetRef="notifierRejet" name="Non"><conditionExpression xsi:type="tFormalExpression">${!valide}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_rejet_fin" sourceRef="notifierRejet" targetRef="fin_rejetee" name="Rejetée"/>
    <sequenceFlow id="f_3" sourceRef="sp_transmission" targetRef="decisionEntreprise"/>
    <sequenceFlow id="f_4" sourceRef="decisionEntreprise" targetRef="gw_decision"/>
    <sequenceFlow id="f_annul1" sourceRef="b_annulation" targetRef="notifierAnnulation"/>
    <sequenceFlow id="f_annul2" sourceRef="notifierAnnulation" targetRef="fin_annulee" name="Annulée"/>
    <sequenceFlow id="f_dec_comp" sourceRef="gw_decision" targetRef="notifierComplement" name="Complément"><conditionExpression xsi:type="tFormalExpression">${decision == 'COMPLEMENT'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_comp_retour" sourceRef="notifierComplement" targetRef="decisionEntreprise"/>
    <sequenceFlow id="f_dec_fin" sourceRef="gw_decision" targetRef="sp_cloture" name="Finale"/>
    <sequenceFlow id="f_5" sourceRef="sp_cloture" targetRef="gw_fin"/>
    <sequenceFlow id="f_fin_ok" sourceRef="gw_fin" targetRef="fin_acceptee" name="Acceptée"><conditionExpression xsi:type="tFormalExpression">${decision == 'ACCEPTEE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_fin_refus" sourceRef="gw_fin" targetRef="fin_refusee" name="Refusée"/>
    <sequenceFlow id="f_e1" sourceRef="err_controles" targetRef="traiterIncident"/>
    <sequenceFlow id="f_e2" sourceRef="err_rejet" targetRef="traiterIncident"/>
    <sequenceFlow id="f_e3" sourceRef="err_transmission" targetRef="traiterIncident"/>
    <sequenceFlow id="f_e4" sourceRef="err_complement" targetRef="traiterIncident"/>
    <sequenceFlow id="f_e5" sourceRef="err_cloture" targetRef="traiterIncident"/>
    <sequenceFlow id="f_i1" sourceRef="traiterIncident" targetRef="gw_action"/>
    <sequenceFlow id="f_abandon" sourceRef="gw_action" targetRef="compenser" name="Abandonner"><conditionExpression xsi:type="tFormalExpression">${action == 'ABANDONNER'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_i2" sourceRef="compenser" targetRef="fin_abandonnee" name="Abandonnée"/>
    <sequenceFlow id="f_relancer" sourceRef="gw_action" targetRef="gw_route" name="Relancer"/>
    <sequenceFlow id="f_r_controles" sourceRef="gw_route" targetRef="sp_controles" name="Contrôles"/>
    <sequenceFlow id="f_r_rejet" sourceRef="gw_route" targetRef="notifierRejet" name="Rejet"><conditionExpression xsi:type="tFormalExpression">${etapeEnErreur == 'REJET'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_r_transmission" sourceRef="gw_route" targetRef="sp_transmission" name="Transmission"><conditionExpression xsi:type="tFormalExpression">${etapeEnErreur == 'TRANSMISSION'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_r_complement" sourceRef="gw_route" targetRef="notifierComplement" name="Complément"><conditionExpression xsi:type="tFormalExpression">${etapeEnErreur == 'COMPLEMENT'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_r_cloture" sourceRef="gw_route" targetRef="sp_cloture" name="Clôture"><conditionExpression xsi:type="tFormalExpression">${etapeEnErreur == 'CLOTURE'}</conditionExpression></sequenceFlow>
  </process>
